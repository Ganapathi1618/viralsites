# --- Supabase -------------------------------------------------------------
# URL + anon key are safe in the browser. Service role is server-only: it
# bypasses RLS and is used by the scraper and the Stripe webhook.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# A recurring $50/month price, created in the Stripe dashboard.
STRIPE_AD_SLOT_PRICE_ID=price_xxx
# Only needed if you swap hosted Checkout for Stripe.js in the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Dodo Payments --------------------------------------------------------
# Hosted checkout link for a sponsor slot. Falls back to the current link if
# unset; set it here when the product is recreated.
NEXT_PUBLIC_DODO_CHECKOUT_URL=https://dodo.pe/lq17vpnfe59

# --- Umami analytics (optional) -------------------------------------------
# Website id from the Umami dashboard. Falls back to the production id baked
# into app/layout.tsx, so tracking still works if this is unset.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=7ef035e8-f978-47fe-a1f9-c42e3f978f77
# Self-hosted? Point these at your instance.
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
UMAMI_API_URL=https://api.umami.is/v1
# Server-only. Without this the tracking script still works, but the header
# badge stays hidden — this is what lets the site read its own numbers back.
# Umami Cloud: Settings -> API keys.
UMAMI_API_KEY=

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret for /api/cron/scrape. Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=change-me
# Comma-separated scrape sources. Defaults to outbid.lol,outbid.fyi.
SCRAPER_SOURCE_URLS=https://outbid.lol,https://outbid.fyi
