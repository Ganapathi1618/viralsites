# --- Supabase -------------------------------------------------------------
# Project URL + anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key is server-only. Used by the scraper + Stripe webhook.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price for a $50/month ad slot (recurring). Create it in the Stripe dashboard.
STRIPE_AD_SLOT_PRICE_ID=price_xxx

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret for /api/cron/scrape. Vercel Cron sends it automatically as
# `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=change-me
# Source the scraper pulls listings from.
SCRAPER_SOURCE_URL=https://outbid.lol
