# --- Supabase -------------------------------------------------------------
# URL + anon key are safe in the browser. Service role is server-only: it
# bypasses RLS and is used by the scraper and the Stripe webhook.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# A recurring $50/month price, created in the Stripe dashboard.
STRIPE_AD_SLOT_PRICE_ID=price_xxx
# Only needed if you swap hosted Checkout for Stripe.js in the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Dodo Payments --------------------------------------------------------
# Hosted checkout link for a sponsor slot. Falls back to the current link if
# unset; set it here when the product is recreated.
NEXT_PUBLIC_DODO_CHECKOUT_URL=https://dodo.pe/lq17vpnfe59

# Signing secret from the Dodo dashboard's webhook settings. Without it,
# /api/webhooks/dodo refuses every request rather than trusting it.
DODO_WEBHOOK_SECRET=whsec_xxx
# Server-only API key, used to open a checkout for the exact bid amount.
# Without it, bidding falls back to the fixed checkout link.
DODO_API_KEY=
# Optional: the product a bid checkout is created against.
DODO_BID_PRODUCT_ID=
DODO_API_URL=https://live.dodopayments.com

# --- Datafast -------------------------------------------------------------
# The website id is public — it ships in the tracking tag, and lives in
# lib/types.ts. The API key is server-only: it can read every visitor record
# for this site, so it must never be exposed with a NEXT_PUBLIC_ prefix.
# Create it at datafa.st -> Website settings -> API. Without it the header
# shows the site count and the "Full stats" link, and no traffic figures.
DATAFAST_API_KEY=
# Override only if Datafast moves the API off its documented base.
DATAFAST_API_URL=https://datafa.st/api/v1

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret for /api/cron/scrape. Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=change-me
# Comma-separated scrape sources. Defaults to outbid.lol,outbid.fyi.
SCRAPER_SOURCE_URLS=https://outbid.lol,https://outbid.fyi
